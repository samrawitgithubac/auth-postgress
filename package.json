{
  "name": "auth-postgres",
  "version": "1.0.0",
  "description": "Teaching project: JWT auth with Express, Prisma, and PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand --forceExit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name update",
    "db:migrate:init": "prisma migrate dev --name init",
    "db:migrate:tasks": "prisma migrate dev --name add_tasks",
    "db:studio": "prisma studio",
    "db:push": "prisma db push"
  },
  "keywords": ["auth", "jwt", "prisma", "postgresql", "express", "teaching"],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
